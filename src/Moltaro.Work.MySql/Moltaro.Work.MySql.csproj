<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The MySQL provider of Moltaro.Work, durable background work for .NET in the application's own database: the store of the items on MySQL 8.4 or later with InnoDB, with the versioned schema script of its tables, which the application applies with its own migration tool.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Read by MySqlWorkStore.SchemaScript. -->
    <EmbeddedResource Include="Schema\version-1.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moltaro.Work\Moltaro.Work.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>

</Project>
