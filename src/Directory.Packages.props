<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Every package version of the repository is declared here, added by the sprint that first needs it. -->
  <ItemGroup>
    <PackageVersion Include="Moltaro.Signals" Version="0.1.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
