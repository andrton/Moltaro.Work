<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The SQL Server provider of Moltaro.Work, durable background work for .NET in the application's own database: the store of the items on SQL Server 2019 or later and Azure SQL Database, with the versioned schema script of its tables, which the application applies with its own migration tool.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Read by SqlServerWorkStore.SchemaScript. -->
    <EmbeddedResource Include="Schema\version-1.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moltaro.Work\Moltaro.Work.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

</Project>
